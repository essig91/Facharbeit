<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>System-Einstellungen</title>
  <style>
    /* Default theme variables (editable by the UI) */
    :root{
      --accent: #2b6fb3;
      --accent-contrast: #ffffff;
      --muted: #666666;
      --bg: #ffffff;
      --card-bg: #ffffff;
      --row-h: 48px;
      --radius: 6px;
      --table-header-bg: var(--accent);
      --table-header-contrast: var(--accent-contrast);
    }

    html,body { height:100%; }
    body {
      font-family: Arial, sans-serif;
      margin:0;
      padding:1rem;
      background:var(--bg);
      color:#111;
      max-width:1100px;
      margin-left:auto;
      margin-right:auto;
    }

    h1 { margin:0 0 .4rem 0; font-size:1.4rem; }
    p.muted { color:var(--muted); margin:.2rem 0 .8rem; }

    .layout {
      display:grid;
      grid-template-columns: 420px 1fr;
      gap: 16px;
      align-items:start;
    }

    .panel {
      background:var(--card-bg);
      border:1px solid rgba(0,0,0,0.06);
      border-radius:8px;
      padding:12px;
      box-sizing:border-box;
      box-shadow: 0 6px 18px rgba(0,0,0,0.04);
    }

    .panel h2 { margin:.0rem 0 .6rem 0; font-size:1rem; }

    .form-row { display:flex; gap:.5rem; align-items:center; margin-bottom:.6rem; }
    .form-row label { min-width:140px; font-weight:600; }
    .form-row input[type="text"], .form-row input[type="number"], .form-row input[type="color"], .form-row select {
      flex:1; padding:8px; border:1px solid #ccc; border-radius:6px; font-size:0.95rem;
    }
    .form-row input[type="checkbox"] { transform:scale(1.1); margin-left:.2rem; }

    .btn { display:inline-block; height:36px; padding:0 12px; border-radius:6px; border:1px solid var(--accent); background:transparent; color:var(--accent); cursor:pointer; line-height:36px; font-size:0.95rem; box-sizing:border-box; }
    .btn:hover { background: rgba(43,111,179,0.06); }
    .btn--primary { background:var(--accent); color:var(--accent-contrast); border-color:var(--accent); }

    .controls { display:flex; gap:.5rem; flex-wrap:wrap; }
    .small { font-size:0.85rem; padding:.25rem .5rem; }

    /* Preview area */
    .preview {
      display:flex;
      flex-direction:column;
      gap:12px;
    }
    .preview .header {
      background:var(--table-header-bg);
      color:var(--table-header-contrast);
      padding:10px 14px;
      border-radius:6px;
      font-weight:700;
    }
    .preview .content {
      border:1px solid #e6e6e6;
      border-radius:6px;
      padding:12px;
      background:#fff;
    }
    .preview .buttons { display:flex; gap:.5rem; }
    .preview .btn-sample { height:34px; padding:0 10px; border-radius:6px; border:1px solid var(--accent); background:transparent; color:var(--accent); display:inline-flex; align-items:center; justify-content:center; }
    .preview table { width:100%; border-collapse:collapse; }
    .preview th, .preview td { padding:8px 10px; border:1px solid #eee; text-align:left; }
    .preview thead th { background:var(--table-header-bg); color:var(--table-header-contrast); line-height:var(--row-h); height:var(--row-h); }
    .preview tbody td { height:var(--row-h); line-height:var(--row-h); }

    .note { font-size:0.9rem; color:var(--muted); margin-top:.5rem; }
    .spacer { flex:1; }

    textarea { width:100%; height:160px; box-sizing:border-box; font-family:monospace; padding:8px; border-radius:6px; border:1px solid #ccc; }

    .row { display:flex; gap:.5rem; align-items:center; }

    /* confirmation modal for IP apply */
    .modal-backdrop {
      position:fixed; inset:0; background:rgba(0,0,0,0.45); display:none; align-items:center; justify-content:center; z-index:9999;
    }
    .modal {
      background:#fff; border-radius:8px; padding:16px; max-width:640px; width:92%; box-shadow:0 8px 28px rgba(0,0,0,0.25);
    }
    .modal h3 { margin-top:0; }
    .modal p { margin:8px 0; color:#222; }

    @media (max-width:980px) {
      .layout { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <h1>System-Einstellungen</h1>
  <p class="muted">Hier legst du globale Design-Variablen (Farbe, Tabelle, Buttons) und die System-IP-Adresse fest. Änderungen werden live in der Vorschau angezeigt.</p>

  <div class="layout">
    <!-- left: controls -->
    <div class="panel">
      <h2>Design / Layout</h2>

      <div class="form-row">
        <label for="accentColor">Accent-Farbe</label>
        <input id="accentColor" type="color" value="#2b6fb3">
      </div>

      <div class="form-row">
        <label for="accentContrast">Kontrast-Text</label>
        <input id="accentContrast" type="color" value="#ffffff">
      </div>

      <div class="form-row">
        <label for="mutedColor">Text (muted)</label>
        <input id="mutedColor" type="color" value="#666666">
      </div>

      <div class="form-row">
        <label for="bgColor">Seiten-Hintergrund</label>
        <input id="bgColor" type="color" value="#ffffff">
      </div>

      <div class="form-row">
        <label for="tableHeaderBg">Tabellen-Header</label>
        <input id="tableHeaderBg" type="color" value="#2b6fb3">
      </div>

      <div class="form-row">
        <label for="tableHeaderContrast">Header Text</label>
        <input id="tableHeaderContrast" type="color" value="#ffffff">
      </div>

      <div class="form-row">
        <label for="rowHeight">Zeilen-Höhe (px)</label>
        <input id="rowHeight" type="number" min="28" max="120" value="48">
      </div>

      <div class="form-row">
        <label for="radius">Ecken (px)</label>
        <input id="radius" type="number" min="0" max="40" value="6">
      </div>

      <hr style="margin:12px 0;border:none;border-top:1px solid #eee">

      <h2>System / Netzwerk</h2>

      <div class="form-row">
        <label for="loggerIp">System IP</label>
        <input id="loggerIp" type="text" placeholder="Aktuelle System-IP" value="">
      </div>

      <div class="form-row">
        <label for="loggerSubnet">Subnetzmaske</label>
        <input id="loggerSubnet" type="text" placeholder="z. B. 255.255.255.0 oder /24" value="">
      </div>

      <div class="form-row">
        <label for="loggerGateway">Gateway</label>
        <input id="loggerGateway" type="text" placeholder="z. B. 192.168.0.1" value="">
      </div>

      <div class="form-row">
        <label>IP übernehmen</label>
        <div class="row">
          <button id="btnApplyIp" class="btn">IP übernehmen</button>
          <span id="applyIpResult" class="muted" style="margin-left:.6rem"></span>
        </div>
      </div>

      <hr style="margin:12px 0;border:none;border-top:1px solid #eee">

      <div style="display:flex; gap:.5rem; align-items:center; flex-wrap:wrap;">
        <button id="btnSave" class="btn btn--primary">Speichern</button>
        <button id="btnReset" class="btn">Auf Standard zurücksetzen</button>
        <div class="spacer"></div>
        <button id="btnExport" class="btn">Export JSON</button>
        <button id="btnImport" class="btn">Import JSON</button>
      </div>

      <div style="margin-top:.6rem">
        <label for="importArea" class="muted">Import / Export</label>
        <textarea id="importArea" placeholder='{"theme":{...},"logger":{"ip":"","subnet":"/24","gateway":""}}'></textarea>
      </div>
    </div>

    <!-- right: preview -->
    <div class="panel preview">
      <div class="header">Vorschau: Seiten-Header</div>

      <div class="content">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
          <div style="font-weight:700">Beispielseite</div>
          <div class="buttons">
            <button class="btn">Neutral</button>
            <button class="btn btn--primary">Primär</button>
            <button class="btn">Ghost</button>
          </div>
        </div>

        <div style="margin-bottom:8px;">
          <table>
            <thead>
              <tr><th style="width:12rem">ID</th><th>Endpoint</th><th>Policy</th><th>Mode</th><th>Aktionen</th></tr>
            </thead>
            <tbody>
              <tr><td style="width:8rem">1770923...</td><td>opc.tcp://192.168.0.10:4840</td><td>None</td><td>None</td><td><button class="btn">Test</button></td></tr>
              <tr><td>2</td><td>opc.tcp://10.0.0.2:4840</td><td>Basic256Sha256</td><td>Sign</td><td><button class="btn">Test</button></td></tr>
            </tbody>
          </table>
        </div>

        <div class="note">Änderungen links werden sofort in dieser Vorschau angewendet. Zum endgültigen Speichern auf "Speichern" klicken.</div>
      </div>
    </div>
  </div>

  <!-- Confirmation modal for applying logger IP -->
  <div id="ipConfirmBackdrop" class="modal-backdrop" role="dialog" aria-hidden="true">
    <div class="modal" role="document" aria-labelledby="ipConfirmTitle">
      <h3 id="ipConfirmTitle">IP übernehmen — Sicherheitsabfrage</h3>
      <p>Wenn Sie die System-IP ändern, kann die Verbindung zum System verlorengehen. Das System kann dann kurzfristig keine Daten mehr schreiben oder lesen, bis die neue Adresse wieder erreichbar ist.</p>
      <p>Stellen Sie sicher, dass die neue IP korrekt ist. Möchten Sie fortfahren?</p>
      <div style="display:flex; gap:.5rem; justify-content:flex-end; margin-top:12px;">
        <button id="ipConfirmCancel" class="btn">Abbrechen</button>
        <button id="ipConfirmOk" class="btn btn--primary">Ja, übernehmen</button>
      </div>
    </div>
  </div>

<script>
  // Default settings object (structure saved to server)
  const DEFAULTS = {
    theme: {
      '--accent': '#2b6fb3',
      '--accent-contrast': '#ffffff',
      '--muted': '#666666',
      '--bg': '#ffffff',
      '--card-bg': '#ffffff',
      '--row-h': '48px',
      '--radius': '6px',
      '--table-header-bg': 'var(--accent)',
      '--table-header-contrast': 'var(--accent-contrast)'
    },
    logger: {
      ip: '',
      subnet: '',
      gateway: ''
    }
  };

  // DOM refs
  const accentColor = document.getElementById('accentColor');
  const accentContrast = document.getElementById('accentContrast');
  const mutedColor = document.getElementById('mutedColor');
  const bgColor = document.getElementById('bgColor');
  const tableHeaderBg = document.getElementById('tableHeaderBg');
  const tableHeaderContrast = document.getElementById('tableHeaderContrast');
  const rowHeight = document.getElementById('rowHeight');
  const radius = document.getElementById('radius');

  const loggerIp = document.getElementById('loggerIp');
  const loggerSubnet = document.getElementById('loggerSubnet');
  const loggerGateway = document.getElementById('loggerGateway');

  const btnApplyIp = document.getElementById('btnApplyIp');
  const applyIpResult = document.getElementById('applyIpResult');

  const btnSave = document.getElementById('btnSave');
  const btnReset = document.getElementById('btnReset');
  const btnExport = document.getElementById('btnExport');
  const btnImport = document.getElementById('btnImport');
  const importArea = document.getElementById('importArea');

  const ipConfirmBackdrop = document.getElementById('ipConfirmBackdrop');
  const ipConfirmOk = document.getElementById('ipConfirmOk');
  const ipConfirmCancel = document.getElementById('ipConfirmCancel');

  // helpers
  function escapeHtml(s){ if(s===null||s===undefined) return ''; return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }
  function showGlobal(t){ const el = document.getElementById('globalMsg'); if(el) el.innerText = t; }

  function applyTheme(theme) {
    if (!theme) return;
    for (const k in theme) {
      try { document.documentElement.style.setProperty(k, theme[k]); } catch(e) {}
    }
    if (theme['--table-header-bg']) document.documentElement.style.setProperty('--table-header-bg', theme['--table-header-bg']);
    if (theme['--table-header-contrast']) document.documentElement.style.setProperty('--table-header-contrast', theme['--table-header-contrast']);
  }

  function getCurrentSettingsFromForm() {
    return {
      theme: {
        '--accent': accentColor.value,
        '--accent-contrast': accentContrast.value,
        '--muted': mutedColor.value,
        '--bg': bgColor.value,
        '--card-bg': bgColor.value,
        '--row-h': rowHeight.value + 'px',
        '--radius': radius.value + 'px',
        '--table-header-bg': tableHeaderBg.value,
        '--table-header-contrast': tableHeaderContrast.value
      },
      logger: {
        ip: loggerIp.value.trim(),
        subnet: loggerSubnet.value.trim(),
        gateway: loggerGateway.value.trim()
      }
    };
  }

  function loadFormFromSettings(cfg) {
    if (!cfg) cfg = DEFAULTS;
    const t = cfg.theme || DEFAULTS.theme;
    accentColor.value = t['--accent'] || DEFAULTS.theme['--accent'];
    accentContrast.value = t['--accent-contrast'] || DEFAULTS.theme['--accent-contrast'];
    mutedColor.value = t['--muted'] || DEFAULTS.theme['--muted'];
    bgColor.value = t['--bg'] || DEFAULTS.theme['--bg'];
    tableHeaderBg.value = (t['--table-header-bg'] && t['--table-header-bg'].startsWith('var(')) ? accentColor.value : (t['--table-header-bg'] || DEFAULTS.theme['--table-header-bg']);
    tableHeaderContrast.value = t['--table-header-contrast'] || DEFAULTS.theme['--table-header-contrast'];
    rowHeight.value = parseInt((t['--row-h'] || DEFAULTS.theme['--row-h']).replace('px','')) || 48;
    radius.value = parseInt((t['--radius'] || DEFAULTS.theme['--radius']).replace('px','')) || 6;

    const l = cfg.logger || DEFAULTS.logger;
    // populate UI with saved settings first (may be empty)
    loggerIp.value = l.ip || '';
    loggerSubnet.value = l.subnet || '';
    loggerGateway.value = l.gateway || '';
    applyTheme(t);
  }

  // Basic validators
  function isValidIp(ip) {
    if (!ip) return false;
    const ipv4 = /^(25[0-5]|2[0-4]\d|1?\d{1,2})(\.(25[0-5]|2[0-4]\d|1?\d{1,2})){3}$/;
    const host = /^[a-zA-Z0-9\.\-]+$/;
    const ipv6 = /:/;
    return ipv4.test(ip) || ipv6.test(ip) || host.test(ip);
  }

  function isValidSubnet(s) {
    if (!s) return false;
    s = s.trim();
    if (/^\/\d{1,2}$/.test(s)) {
      const n = Number(s.slice(1));
      return n >= 0 && n <= 128;
    }
    const octets = s.split('.');
    if (octets.length === 4) {
      const nums = octets.map(o => Number(o));
      if (nums.some(n => isNaN(n) || n < 0 || n > 255)) return false;
      const bits = nums.map(n => n.toString(2).padStart(8,'0')).join('');
      return /^1*0*$/.test(bits);
    }
    if (/^\d{1,2}$/.test(s)) {
      const n = Number(s);
      return n >= 0 && n <= 128;
    }
    return false;
  }

  // Convert dotted mask or numeric mask to "/N" prefix form, else return null
  function dottedMaskToPrefix(mask) {
    if (!mask) return null;
    mask = String(mask).trim();
    if (mask.startsWith('/')) {
      const n = Number(mask.slice(1));
      if (!isNaN(n) && n >= 0 && n <= 128) return '/' + n;
      return null;
    }
    if (/^\d{1,2}$/.test(mask)) {
      const n = Number(mask);
      if (n >= 0 && n <= 128) return '/' + n;
      return null;
    }
    const oct = mask.split('.');
    if (oct.length !== 4) return null;
    let bits = '';
    for (const o of oct) {
      const n = Number(o);
      if (isNaN(n) || n < 0 || n > 255) return null;
      bits += n.toString(2).padStart(8,'0');
    }
    if (!/^1*0*$/.test(bits)) return null;
    const ones = (bits.match(/1/g) || []).length;
    return '/' + ones;
  }

  // Convert "/N" prefix to dotted mask "255.255.255.0"
  function prefixToDotted(prefix) {
    if (!prefix) return '';
    prefix = String(prefix).trim();
    if (prefix.startsWith('/')) prefix = prefix.slice(1);
    if (!/^\d{1,2}$/.test(prefix)) return '';
    const n = Number(prefix);
    if (isNaN(n) || n < 0 || n > 128) return '';
    let bits = ''.padStart(n, '1').padEnd(32, '0');
    const parts = [];
    for (let i = 0; i < 4; i++) {
      const oct = bits.slice(i*8, i*8+8);
      parts.push(parseInt(oct, 2));
    }
    return parts.join('.');
  }

  // Update form fields from actual system network status (calls /api/network/status)
  async function populateNetworkFromSystem(iface = 'eth0') {
    // ensure a slight delay so server is fully ready and UI has rendered
    await new Promise(r => setTimeout(r, 600));

    try {
      const res = await fetch(`/api/network/status?iface=${encodeURIComponent(iface)}`);
      if (!res.ok) return;
      const j = await res.json().catch(()=>null);
      if (!j) return;

      // j.ips is expected to be array of "addr/prefix" strings, e.g. ["192.168.0.151/24"]
      if (Array.isArray(j.ips) && j.ips.length > 0) {
        const entry = j.ips[0];
        const [addr, prefix] = (entry || '').split('/');
        if (addr) loggerIp.value = addr;
        if (prefix) {
          const dotted = prefixToDotted('/' + prefix);
          // prefer dotted form for display; if conversion fails, show /N
          loggerSubnet.value = dotted || ('/' + prefix);
        }
      }

      // if backend returns gateway in j.gateway, use it (server may not yet provide it)
      if (j.gateway) {
        loggerGateway.value = j.gateway;
      } else {
        // if not provided by status API, try to fetch saved settings (contains gateway)
        try {
          const sres = await fetch('/api/settings');
          if (sres.ok) {
            const s = await sres.json().catch(()=>null);
            if (s && s.logger && s.logger.gateway) loggerGateway.value = s.logger.gateway;
          }
        } catch (_) {}
      }
    } catch (e) {
      console.warn('populateNetworkFromSystem error', e);
    }
  }

  // Save to server (PUT /api/settings) - backend should accept the payload
  async function saveSettings() {
    const cfg = getCurrentSettingsFromForm();
    // basic validation
    if (cfg.logger.ip && !isValidIp(cfg.logger.ip)) {
      alert('Ungültige IP/Hostname für das System.');
      return;
    }
    if (cfg.logger.subnet && !isValidSubnet(cfg.logger.subnet)) {
      alert('Ungültige Subnetzmaske. Verwenden Sie z. B. 255.255.255.0 oder /24.');
      return;
    }
    if (loggerGateway && loggerGateway.value) {
      cfg.logger.gateway = loggerGateway.value.trim();
    }

    // Normalize subnet to "/N" form before saving (server expects /N)
    if (cfg.logger.subnet) {
      const normalized = dottedMaskToPrefix(cfg.logger.subnet);
      if (normalized) cfg.logger.subnet = normalized;
    }

    try {
      const res = await fetch('/api/settings', {
        method: 'PUT',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify(cfg)
      });
      if (!res.ok) {
        const txt = await res.text();
        throw new Error(txt || 'HTTP ' + res.status);
      }
      showGlobal('Einstellungen gespeichert.');
    } catch (err) {
      alert('Speichern fehlgeschlagen: ' + (err.message || String(err)));
      console.error('saveSettings error', err);
    }
  }

  // Apply Logger IP (ruft Network API und pollt Status)
  async function applyLoggerIpConfirmed() {
    const ip = loggerIp.value.trim();
    const subnet = loggerSubnet.value.trim();
    const gateway = (typeof loggerGateway !== 'undefined' && loggerGateway) ? loggerGateway.value.trim() : '';

    if (!ip) { alert('Bitte eine IP eintragen.'); return; }
    if (!isValidIp(ip)) { alert('Ungültige IP/Hostname.'); return; }
    if (subnet && !isValidSubnet(subnet)) { alert('Ungültige Subnetzmaske. Verwenden Sie z. B. 255.255.255.0 oder /24.'); return; }

    // Normalize subnet into "/N" for the network API to avoid prefix=0
    let normalizedSubnet = '/24';
    if (subnet) {
      const n = dottedMaskToPrefix(subnet);
      if (n) normalizedSubnet = n;
      else {
        if (/^\d{1,2}$/.test(subnet)) normalizedSubnet = '/' + subnet;
        else normalizedSubnet = subnet; // last resort, let backend validate
      }
    }

    // Confirmation modal already closed by caller (ipConfirmOk handler). Show interim status.
    applyIpResult.textContent = 'Übernehme...';
    btnApplyIp.disabled = true;

    try {
      // Prepare payload for network API
      const payload = {
        iface: 'eth0',
        ip: ip,
        subnet: normalizedSubnet,
        gateway: gateway || undefined
      };

      // Call the network apply API
      const res = await fetch('/api/network/apply', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify(payload)
      });

      let json = null;
      const text = await res.text();
      try { json = text ? JSON.parse(text) : null; } catch (e) { json = null; }

      if (!res.ok) {
        const err = (json && json.error) ? json.error : (text || `HTTP ${res.status}`);
        applyIpResult.textContent = 'Fehler beim Auslösen';
        alert('Fehler beim Anwenden der IP: ' + err);
        btnApplyIp.disabled = false;
        return;
      }

      applyIpResult.textContent = 'Änderung ausgelöst, warte auf Zuweisung...';

      const pollIntervalMs = 2000;
      const timeoutMs = 120000;
      const deadline = Date.now() + timeoutMs;

      const targetPure = ip.split('/')[0];

      while (Date.now() < deadline) {
        try {
          const sres = await fetch(`/api/network/status?iface=${encodeURIComponent('eth0')}`, { method: 'GET' });
          if (sres.ok) {
            const sjson = await sres.json().catch(()=>null);
            if (sjson && Array.isArray(sjson.ips)) {
              const found = sjson.ips.some(e => {
                if (!e) return false;
                const addr = e.split('/')[0];
                return addr === targetPure;
              });
              if (found) {
                applyIpResult.textContent = '  bernommen';
                try {
                  const dotted = prefixToDotted(normalizedSubnet);
                  if (dotted) loggerSubnet.value = dotted;
                  await saveSettings();
                } catch(e) { console.warn('saveSettings failed', e); }
                btnApplyIp.disabled = false;
                return;
              }
            }
          } else {
            console.warn('Status query failed', sres.status);
          }
        } catch (e) {
          console.warn('Error polling status', e);
        }
        await new Promise(r => setTimeout(r, pollIntervalMs));
      }

      applyIpResult.textContent = 'Timeout — evtl. Rollback ausgeführt';
      alert('Die neue IP wurde innerhalb des Zeitlimits nicht gesetzt. Es wurde möglicherweise ein Rollback ausgeführt. Bitte prüfen Sie die Netzwerkkonfiguration oder Logs.');
      btnApplyIp.disabled = false;
    } catch (err) {
      console.error('applyLoggerIpConfirmed error', err);
      applyIpResult.textContent = 'Fehler';
      alert('Unerwarteter Fehler beim Anwenden der IP: ' + (err && err.message ? err.message : String(err)));
      btnApplyIp.disabled = false;
    }
  }

  function openIpConfirmModal() {
    ipConfirmBackdrop.style.display = 'flex';
    ipConfirmBackdrop.setAttribute('aria-hidden','false');
  }
  function closeIpConfirmModal() {
    ipConfirmBackdrop.style.display = 'none';
    ipConfirmBackdrop.setAttribute('aria-hidden','true');
  }

  ipConfirmCancel.addEventListener('click', () => {
    closeIpConfirmModal();
  });

  ipConfirmOk.addEventListener('click', async () => {
    closeIpConfirmModal();
    await applyLoggerIpConfirmed();
  });

  function resetToDefaults() {
    if (!confirm('Auf Standard-Werte zurücksetzen?')) return;
    loadFormFromSettings(DEFAULTS);
    showGlobal('Auf Standard zurückgesetzt (noch nicht gespeichert).');
  }

  function exportJson() {
    const cfg = getCurrentSettingsFromForm();
    importArea.value = JSON.stringify(cfg, null, 2);
  }

  function importJson() {
    try {
      const j = JSON.parse(importArea.value);
      loadFormFromSettings(j);
      showGlobal('Import geladen (noch nicht gespeichert).');
    } catch (e) {
      alert('Ungültiges JSON: ' + e.message);
    }
  }

  // Load settings from server (GET /api/settings) if available, else load DEFAULTS
  async function loadSettingsFromServer() {
    try {
      const res = await fetch('/api/settings');
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const j = await res.json();
      loadFormFromSettings(j);
      // populate runtime network info after a short delay (600 ms)
      await populateNetworkFromSystem('eth0');
      showGlobal('Einstellungen geladen');
    } catch (e) {
      console.info('loadSettingsFromServer failed, using defaults', e);
      loadFormFromSettings(DEFAULTS);
      await populateNetworkFromSystem('eth0');
    }
  }

  // wire buttons
  btnSave.addEventListener('click', saveSettings);
  btnReset.addEventListener('click', resetToDefaults);
  btnExport.addEventListener('click', exportJson);
  btnImport.addEventListener('click', importJson);
  btnApplyIp.addEventListener('click', () => openIpConfirmModal());

  // initial load: try server settings then apply to preview
  document.addEventListener('DOMContentLoaded', () => {
    loadSettingsFromServer().catch(()=>{ loadFormFromSettings(DEFAULTS); });
  });

  // ensure initial theme applied
  applyTheme(DEFAULTS.theme);
</script>
</body>
</html>